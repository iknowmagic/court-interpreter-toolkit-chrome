{
  "watch": [
    "src",
    "public",
    "manifest.json",
    "manifest.dev.json",
    "vite.config.base.ts",
    "vite.config.chrome.ts",
    "custom-vite-plugins.ts",
    "package.json"
  ],
  "ext": "tsx,css,html,ts,json,js,png",
  "ignore": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "dist_chrome/**",
    "build/**",
    "tmp/**"
  ],
  "exec": "pnpm build:chrome:dev"
}
